      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(soroban_pulse_http_request_duration_seconds_count{status_code=~\"5..\"}[5m]) / rate(soroban_pulse_http_request_duration_seconds_count[5m])",
          "legendFormat": "5xx Error Rate",
          "refId": "A"
        }
      ],
      "title": "Error Rate by Status Code (Issue #896)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
