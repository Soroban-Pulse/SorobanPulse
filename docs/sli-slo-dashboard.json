      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(1 - (rate(soroban_pulse_http_request_duration_seconds_count{status_code=~\"5..\"}[5m]) / rate(soroban_pulse_http_request_duration_seconds_count[5m])))",
          "legendFormat": "Availability",
          "refId": "A"
        }
      ],
      "title": "API Availability (Issue #896)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
