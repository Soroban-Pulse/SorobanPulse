      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "increase(soroban_pulse_slo_evaluation_total[5m])",
          "legendFormat": "{{slo}} ({{status}})",
          "refId": "A"
        }
      ],
      "title": "SLO Status Transitions (5m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "HTTP request latency percentiles (p50, p95, p99) for SLI measurements.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2, "drawStyle": "line" },
