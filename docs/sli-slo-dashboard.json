      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "soroban_pulse_slo_burn_rate",
          "legendFormat": "{{slo}}",
          "refId": "A"
        }
      ],
      "title": "SLO Burn Rate",
      "type": "timeseries"
    },
